# deployd configuration reference.
# In production this file is rendered and delivered by Puppet to
# /etc/provision/config.yaml on the provision server. In the test
# environment it is seeded manually (see README.md).

redis:
  host: deploy.tech.dreamhack.se
  port: 1338
  ssl: true
  password: {env: REDIS_PASSWORD}

vault:
  url: https://vault.tech.dreamhack.se
  mount_env: VAULT_MOUNT   # mount point comes from this env var

managers:
  # Proxmox VE cluster (API token auth)
  - name: coloc
    type: proxmox
    api_url: https://10.10.10.1:8006
    token_id: provisioner@pve!dev
    token_secret: {env: PVE_TOKEN_SECRET}   # or {vault: proxmox/coloc}
    verify_tls: /etc/ssl/certs/dhtech-ca.crt   # path | true (system CAs) | false (lab only)
    bridge: vmbr0
    deploy_vlan: 100
    node: null          # null = pick node with most free memory
    pool: null          # optional resource pool ("datacenter" equivalent)

  # VMware vCenter/ESXi
  - name: event
    type: vmware
    host: vcenter.event.dreamhack.local
    fqdn: esxi.event.dreamhack.local
    username: {vault: vmware/event}          # field "username"
    password: {vault: vmware/event}          # field "password"
    verify_tls: /etc/ssl/certs/dhtech-ca.crt
    deploy_vlan: 509
