# Gen-3 preseed (goodies from the hardened production preseed folded in):
# install over DHCP on the deployment VLAN; per-host secrets and target
# config come from the dynamic early.py / late.py scripts.

d-i debian-installer/language string en
d-i debian-installer/country string SE
d-i debian-installer/locale string en_US.UTF-8
d-i keyboard-configuration/unsupported_layout boolean true
d-i keyboard-configuration/unsupported_options boolean true
d-i keyboard-configuration/unsupported_config_layout boolean true
d-i keyboard-configuration/unsupported_config_options boolean true
d-i keyboard-configuration/xkb-keymap select se
d-i keyboard-configuration/layoutcode string se
d-i keyboard-configuration/modelcode string pc105

d-i netcfg/choose_interface select auto
d-i netcfg/dhcp_timeout string 60
d-i netcfg/wireless_wep string
d-i hw-detect/load_firmware boolean true

d-i mirror/country string manual
d-i mirror/http/hostname string deb.debian.org
d-i mirror/http/directory string /debian
# All package fetches go through apt-cacher-ng on the provision server
d-i mirror/http/proxy string http://10.100.0.2:3142
d-i mirror/suite string trixie

# Root password is generated per host by early.py and stored in the
# secret store (OpenBao); no user account.
d-i preseed/early_command string \
    dh_v4=$(sed -n 's/.*dh_v4=\([^ ]*\).*/\1/p' /proc/cmdline); \
    dh_base=$(sed -n 's/.*dh_base=\([^ ]*\).*/\1/p' /proc/cmdline); \
    wget -q -O /tmp/dh-early "$dh_base/early.py?hack_ip=$dh_v4" && sh /tmp/dh-early
d-i passwd/root-login boolean true
d-i passwd/make-user boolean false

d-i clock-setup/utc boolean true
d-i time/zone string Europe/Stockholm
d-i clock-setup/ntp boolean true

# Hardened partitioning (from production): GPT + EFI + /boot, LVM vgsys
# with separated LVs and nodev/nosuid/noexec where it counts. Minimums
# scaled to fit small test disks; priorities/maximums approach the
# production layout on real hardware.
# partman-auto/method is set by early.py (lvm; crypto for EVENT hosts)
# The OS always lives on the LARGEST disk; the appdisk is handled by the
# late script, never by partman. Device names are nondeterministic with
# two virtio-scsi disks (the appdisk can enumerate as sda — seen live:
# the OS installed onto an 11G appdisk after "too small ... skipping"),
# so partman/early_command pins the target by size. The static line
# below is only a fallback if that command fails.
d-i partman-auto/disk string /dev/sda
d-i partman/early_command string \
    big=""; bigsize=0; \
    for dev in $(list-devices disk); do \
      b=${dev##*/}; s=$(cat /sys/block/$b/size 2>/dev/null || echo 0); \
      if [ "$s" -gt "$bigsize" ]; then bigsize=$s; big=$dev; fi; \
    done; \
    if [ -n "$big" ]; then \
      debconf-set partman-auto/disk "$big"; \
      debconf-set grub-installer/bootdev "$big"; \
    fi
d-i partman-auto-lvm/guided_size string max
d-i partman-lvm/device_remove_lvm boolean true
d-i partman-md/device_remove_md boolean true
d-i partman-lvm/confirm boolean true
d-i partman-lvm/confirm_nooverwrite boolean true
d-i partman-auto/choose_recipe select dhtech-default
d-i partman-auto-lvm/new_vg_name string vgsys
d-i partman-auto/expert_recipe string                                \
      dhtech-default ::                                              \
              256 512 512 fat32                                      \
                      $primary{ } $iflabel{ gpt } $reusemethod{ }    \
                      method{ efi } format{ }                        \
                      label{ EFI System Partition }                  \
                      mountpoint{ /boot/efi }                        \
              .                                                      \
              1024 1024 1024 ext4                                      \
                      $primary{ } $bootable{ }                       \
                      method{ format } format{ }                     \
                      use_filesystem{ } filesystem{ ext4 }           \
                      mountpoint{ /boot }                            \
              .                                                      \
              4096 4096 4096 linux-swap                               \
                      $lvmok{ } lv_name{ lvswap }                    \
                      method{ swap } format{ }                       \
              .                                                      \
              4096 4096 4096 ext4                                    \
                      $lvmok{ } lv_name{ lvhome }                    \
                      method{ format } format{ }                     \
                      use_filesystem{ } filesystem{ ext4 }           \
                      mountpoint{ /home }                            \
                      options/nodev{ nodev }                         \
                      options/nosuid{ nosuid }                       \
                      options/noexec{ noexec }                       \
              .                                                      \
              4096 4096 4096 ext4                                    \
                      $lvmok{ } lv_name{ lvvartmp }                  \
                      method{ format } format{ }                     \
                      use_filesystem{ } filesystem{ ext4 }           \
                      mountpoint{ /var/tmp }                         \
                      options/nodev{ nodev }                         \
                      options/nosuid{ nosuid }                       \
                      options/noexec{ noexec }                       \
              .                                                      \
              4096 4096 4096 ext4                                    \
                      $lvmok{ } lv_name{ lvtmp }                     \
                      method{ format } format{ }                     \
                      use_filesystem{ } filesystem{ ext4 }           \
                      mountpoint{ /tmp }                             \
                      options/nodev{ nodev }                         \
                      options/nosuid{ nosuid }                       \
                      options/noexec{ noexec }                       \
              .                                                      \
              15360 15360 15360 ext4                                    \
                      $lvmok{ } lv_name{ lvvarlog }                  \
                      method{ format } format{ }                     \
                      use_filesystem{ } filesystem{ ext4 }           \
                      mountpoint{ /var/log }                         \
                      options/nodev{ nodev }                         \
                      options/nosuid{ nosuid }                       \
                      options/noexec{ noexec }                       \
              .                                                      \
              4096 4096 4096 ext4                                    \
                      $lvmok{ } lv_name{ lvvarlogaudit }             \
                      method{ format } format{ }                     \
                      use_filesystem{ } filesystem{ ext4 }           \
                      mountpoint{ /var/log/audit }                   \
                      options/nodev{ nodev }                         \
                      options/nosuid{ nosuid }                       \
                      options/noexec{ noexec }                       \
              .                                                      \
              15360 15360 15360 ext4                                   \
                      $lvmok{ } lv_name{ lvvar }                     \
                      method{ format } format{ }                     \
                      use_filesystem{ } filesystem{ ext4 }           \
                      mountpoint{ /var }                             \
                      options/nodev{ nodev }                         \
                      options/nosuid{ nosuid }                       \
              .                                                      \
              1024 1000 30000 ext4                                  \
                      $lvmok{ } lv_name{ lvroot }                    \
                      method{ format } format{ }                     \
                      use_filesystem{ } filesystem{ ext4 }           \
                      mountpoint{ / }                                \
              .
d-i partman-partitioning/confirm_write_new_label boolean true
d-i partman/choose_partition select finish
d-i partman/confirm boolean true
d-i partman/confirm_nooverwrite boolean true
d-i partman-efi/non_efi_system boolean true

d-i apt-setup/non-free boolean true
d-i apt-setup/contrib boolean true

tasksel tasksel/first multiselect standard, ssh-server
# Hardening + ops package set from production, plus the deploy-flow needs
d-i pkgsel/include string vim mtr-tiny tmux tcpdump ntpsec lsof dnsutils htop lsscsi sysstat apt-transport-https sudo auditd audispd-plugins curl apparmor-utils libpam-pwquality libyaml-tiny-perl libsort-naturally-perl libfile-slurp-perl nftables wget ca-certificates puppet-agent
d-i pkgsel/upgrade select full-upgrade
popularity-contest popularity-contest/participate boolean false

d-i grub-installer/only_debian boolean true
d-i grub-installer/bootdev string default

# All per-host target configuration lives in the dynamic late script.
d-i preseed/late_command string \
    dh_v4=$(sed -n 's/.*dh_v4=\([^ ]*\).*/\1/p' /proc/cmdline); \
    dh_base=$(sed -n 's/.*dh_base=\([^ ]*\).*/\1/p' /proc/cmdline); \
    wget -q -O /tmp/dh-late "$dh_base/late.py?hack_ip=$dh_v4" && sh /tmp/dh-late

d-i finish-install/reboot_in_progress note
