# Test-env preseed (gen-3 flow): install over DHCP on the deployment
# VLAN; write production network config + nftables baseline; signal
# finish so provisiond flips the VLAN. Prod adds vault passwords, LUKS
# and puppet - kept out of the test flavor.

d-i debian-installer/locale string en_US.UTF-8
d-i keyboard-configuration/xkb-keymap select se

d-i mirror/country string manual
d-i mirror/http/hostname string deb.debian.org
d-i mirror/http/directory string /debian
# All package fetches go through apt-cacher-ng on the provision server
d-i mirror/http/proxy string http://10.100.0.2:3142
d-i mirror/suite string trixie

# Root password is generated per host by early.py and stored in the
# secret store (OpenBao); no user account.
d-i preseed/early_command string \
    dh_v4=$(sed -n 's/.*dh_v4=\([^ ]*\).*/\1/p' /proc/cmdline); \
    dh_base=$(sed -n 's/.*dh_base=\([^ ]*\).*/\1/p' /proc/cmdline); \
    wget -q -O /tmp/dh-early "$dh_base/early.py?hack_ip=$dh_v4" && sh /tmp/dh-early
d-i passwd/root-login boolean true
d-i passwd/make-user boolean false

d-i clock-setup/utc boolean true
d-i time/zone string Europe/Stockholm
d-i clock-setup/ntp boolean false

# partman-auto/method is set by early.py (lvm; crypto for EVENT hosts)
d-i partman-auto/choose_recipe select atomic
d-i partman-auto-lvm/guided_size string max
d-i partman-partitioning/confirm_write_new_label boolean true
d-i partman/choose_partition select finish
d-i partman/confirm boolean true
d-i partman/confirm_nooverwrite boolean true
d-i partman-lvm/confirm boolean true
d-i partman-lvm/confirm_nooverwrite boolean true
d-i partman-lvm/device_remove_lvm boolean true
d-i partman-efi/non_efi_system boolean true

tasksel tasksel/first multiselect standard
d-i pkgsel/include string openssh-server nftables wget ca-certificates puppet-agent
popularity-contest popularity-contest/participate boolean false
d-i pkgsel/upgrade select none

d-i grub-installer/only_debian boolean true
d-i grub-installer/bootdev string default

# All per-host target configuration lives in the dynamic late script.
d-i preseed/late_command string \
    dh_v4=$(sed -n 's/.*dh_v4=\([^ ]*\).*/\1/p' /proc/cmdline); \
    dh_base=$(sed -n 's/.*dh_base=\([^ ]*\).*/\1/p' /proc/cmdline); \
    wget -q -O /tmp/dh-late "$dh_base/late.py?hack_ip=$dh_v4" && sh /tmp/dh-late

d-i finish-install/reboot_in_progress note
