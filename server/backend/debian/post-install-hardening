### Site-specific outside CIS
# Disable wifi kernel modules
cat >/etc/modprobe.d/wifi.conf <<EOF
install rfkill /bin/true
blacklist rfkill
install cfg80211 /bin/true
blacklist cfg80211
EOF

# disable ipv6 autoconf
echo "net.ipv6.conf.all.autoconf = 0" >> /etc/sysctl.d/dh-ipv6.conf

# minimal use of swap
echo "vm.swappiness = 1" > /etc/sysctl.d/dh-swappiness.conf

# arp config
echo "net.ipv4.conf.all.arp_filter = 1" > /etc/sysctl.d/dh-arp.conf
echo "net.ipv4.conf.all.arp_announce = 1" >> /etc/sysctl.d/dh-arp.conf

# always synchronize ntp
sed -i '2itinker panic 0' /etc/ntpsec/ntp.conf

# disable root login to ssh
#sed -i 's/^PermitRootLogin.*/PermitRootLogin no/' /etc/ssh/sshd_config

# disable reboot on ctrl alt del
rm /lib/systemd/system/ctrl-alt-del.target
ln -s /dev/null /lib/systemd/system/ctrl-alt-del.target

# histtimeformat
echo "HISTTIMEFORMAT='%F %T '" > /etc/profile.d/dh-histtimeformat.sh
echo "export HISTTIMEFORMAT" >> /etc/profile.d/dh-histtimeformat.sh
chmod +x /etc/profile.d/dh-histtimeformat.sh

# ntp
mkdir /var/log/ntpsec
chown ntpsec:ntpsec /var/log/ntpsec
sed -i 's/^server/#server/g' /etc/ntpsec/ntp.conf
sed -i 's/^pool/#pool/g' /etc/ntpsec/ntp.conf
echo "server 100.65.0.5 iburst" >> /etc/ntpsec/ntp.conf
echo "server 100.65.0.6 iburst" >> /etc/ntpsec/ntp.conf
echo "server 100.65.0.7 iburst" >> /etc/ntpsec/ntp.conf

# Hypervisor guest tools by platform. (The old check used [ x > y ],
# which is a redirect inside [ ] - always true, and it littered a file
# named "0"; open-vm-tools ended up on every machine.)
case "$(dmidecode -s system-manufacturer 2>/dev/null)" in
  *VMware*) apt-get -y install open-vm-tools ;;
  *QEMU*)   apt-get -y install qemu-guest-agent ;;
esac

# Remove unwanted packages here.
apt-get purge -y os-prober laptop-detect

# Remove quiet from cmdline
sed -i 's/GRUB_CMDLINE_LINUX_DEFAULT="quiet"/GRUB_CMDLINE_LINUX_DEFAULT=""/' /etc/default/grub

# update grub
update-grub

# set vim as default editor
update-alternatives --set editor /usr/bin/vim.basic

# switch apt
sed -i 's|http://|https://|' /etc/apt/sources.list
#sed -i 's/qbranch/qmgmt/g' /etc/apt/sources.list

# discard for lvm (this is for thin provisioning through all layers)
sed -i 's/# issue_discards = 0/issue_discards = 1/' /etc/lvm/lvm.conf

# sync to disk
sync; sync
