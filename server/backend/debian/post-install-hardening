#### 5.1.15 Ensure SSH LogLevel is appropriate
# LogLevel is set to INFO as default
# Compliant by default, no changes needed
#### 5.2.6 Ensure SSH PAM is enabled (Automated) - Default
#### 5.1.20 Ensure SSH root login is disabled (Automated) - Default
#sed -i 's/#PermitRootLogin prohibit-password/PermitRootLogin no/g' /etc/ssh/sshd_config
echo "PermitRootLogin no" >> /etc/ssh/sshd_config.d/dhtech.conf

#### 5.1.19 Ensure SSH PermitEmptyPasswords is disabled
#sed -i 's/#PermitEmptyPasswords no/PermitEmptyPasswords no/g' /etc/ssh/sshd_config
