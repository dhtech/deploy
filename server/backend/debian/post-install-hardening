#### 5.1.2 Ensure permissions on SSH private host key files are configured 
# Compliant by default, no changes needed

#### 5.1.3 Ensure permissions on SSH public host key files are configured 
# Compliant by default, no changes needed

#### 5.1.4 Ensure SSH access is limited
#sed -i '39 a DenyUsers root' /etc/ssh/sshd_config
echo "DenyUsers root" >> /etc/ssh/sshd_config.d/dhtech.conf

#### 5.1.5 Ensure sshd Banner is configured (Automated)
echo "Authorized uses only. All activity may be monitored and reported." > /etc/issue
echo "Authorized uses only. All activity may be monitored and reported." > /etc/issue.net
#sed -i 's/#Banner none/Banner \/etc\/issue.net/g' /etc/ssh/sshd_config
echo "Banner /etc/issue.net" >> /etc/ssh/sshd_config.d/dhtech.conf
### 5.1.6 Ensure sshd Ciphers are configured (Automated) - Compliant by default
### 5.1.7 Ensure sshd ClientAliveInterval and ClientAliveCountMax are configured (Automated)
#sed -i 's/#ClientAliveInterval 0/ClientAliveInterval 300/g' /etc/ssh/sshd_config
#sed -i 's/#ClientAliveCountMax 3/ClientAliveCountMax 0/g' /etc/ssh/sshd_config
echo "ClientAliveInterval 300" >> /etc/ssh/sshd_config.d/dhtech.conf
echo "ClientAliveCountMax 0" >> /etc/ssh/sshd_config.d/dhtech.conf
### 5.1.8 Ensure DisableForwarding is enabled (Automated) - We use forwarding so not disabled
### 5.1.9 Ensure sshd GSSAPIAuthentication is disabled (Automated) - This may be in use, not disabled

