echo "PermitUserEnvironment no" >> /etc/ssh/sshd_config.d/dhtech.conf

#### 5.1.11 Ensure SSH IgnoreRhosts is enabled
#sed -i 's/#IgnoreRhosts yes/IgnoreRhosts yes/g' /etc/ssh/sshd_config
echo "IgnoreRhosts yes" >> /etc/ssh/sshd_config.d/dhtech.conf

#### 5.2.12 Ensure SSH X11 forwarding is disabled 
