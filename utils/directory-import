#!/usr/bin/env python3
"""Transform a production slapcat dump into a clean gen-3 LDIF.

Reads slapcat LDIF on stdin, writes sanitized LDIF on stdout. Pure
transform - no LDAP connection. Meant to be re-run on every fresh prod
dump:

    incremental top-up (existing entries skipped):
        ./directory-import < thecat.ldif | ssh <master> ldapadd -c -x \\
                -D cn=admin,dc=dreamhack,dc=se -w <pw>

    full refresh: wipe the sub-trees on master A first (ldapdelete -r of
    dc=tech/dc=event/dc=colo/dc=crew children), then load as above;
    mirrors and slaves resync automatically.

What it does:
    - drops FusionDirectory/GOsa: every gosa*/fd* objectClass and their
        attributes, the ou=fusiondirectory / ou=aclroles / ou=templates /
        ou=snapshots subtrees, and FD service accounts at the root
    - keeps an attribute allowlist (posix/inetOrgPerson essentials,
        sshPublicKey, jpegPhoto, group membership); base64 values are
        passed through byte-exact
    - skips base containers the servers seed themselves (suffix, sub-dcs,
        ou=people/ou=groups, cn=replicator)
    - prunes member DNs that point at skipped entries
"""

import base64
import sys

SKIP_SUBTREE_MARKERS = ('ou=fusiondirectory', 'ou=aclroles',
                        'ou=templates', 'ou=snapshots', 'ou=snapshots,')
DROP_CLASS_PREFIXES = ('gosa', 'fd')
KEEP_ATTRS = {
    'objectclass', 'dc', 'o', 'ou', 'uid', 'cn', 'sn', 'givenname',
    'mail', 'uidnumber', 'gidnumber', 'homedirectory', 'loginshell',
    'sshpublickey', 'member', 'memberuid', 'description', 'l',
    'jpegphoto', 'dhshoesize', 'dhshirtsize', 'dhhelmetsize',
    'dharrivaldate', 'dhdeparturedate', 'dhcarregistration',
}
KEEP_ATTR_PREFIXES = ('shadow',)
# containers dh-ldap-config seeds on the masters - never import them:
# the suffix, the sub-dcs, and ou=people/ou=groups DIRECTLY under them
# (deeper OUs like ou=groups,ou=services,dc=event are real data)
import re
SEEDED_RE = re.compile(
    r'^(dc=[^,]+,)?dc=dreamhack,dc=se$|'
    r'^(ou=people|ou=groups),(dc=[^,]+,)?dc=dreamhack,dc=se$',
    re.IGNORECASE)


# THE CANONICAL TEAMS (user decree 2026-08-28): the prod team zoo is
# replaced by these 8. Members map from the old groups (source cns;
# nested *-gl-team memberships resolve to people); gidNumbers are
# FRESH - prod's gids deliberately do not carry over. The old source
# groups are dropped; every other group imports untouched.
EVENT = 'dc=event,dc=dreamhack,dc=se'
TEAMS = [
    # (cn, parent, gid, description, source group cns)
    ('access-team', 'ou=groups,ou=access,' + EVENT, 20001,
     'Access team', ('access-participants-team', 'access-wifi-team')),
    ('core-team', 'ou=groups,ou=core,' + EVENT, 20002,
     'Core team', ('core-team',)),
    ('logistics-team', 'ou=groups,ou=logistics,' + EVENT, 20003,
     'Logistics team', ('logistics-team',)),
    ('services-team', 'ou=groups,ou=services,' + EVENT, 20004,
     'Services team', ('services-team',)),
    ('resource-team', 'ou=groups,ou=resources,' + EVENT, 20005,
     'Resource team', ('resources-team',)),
    ('gl-team', 'ou=groups,' + EVENT, 20006,
     'Group leaders', ('gl', 'access-participants-gl-team',
                       'access-wifi-gl-team', 'core-gl-team',
                       'logistics-gl-team', 'services-gl-team')),
    ('tl-team', 'ou=groups,' + EVENT, 20007,
     'Team leaders', ('tl-team',)),
    ('colo-team', 'ou=groups,dc=colo,dc=dreamhack,dc=se', 20008,
     'Colo team (standing, off-event)', ('services-colo-team',)),
]
TEAM_SOURCE_CNS = {cn for *_, sources in TEAMS for cn in sources}
# the merged access dept has no OU in prod - scaffold it
TEAM_NEW_OUS = ('ou=access,' + EVENT, 'ou=groups,ou=access,' + EVENT)


def resolve_members(dn, groups_by_dn, seen=None):
    """The people behind a group: member DNs, nested groups (prod's
    cn=gl holds the *-gl-team GROUPS) expanded recursively."""
    seen = seen or set()
    if dn in seen or dn not in groups_by_dn:
        return set()
    seen.add(dn)
    people = set()
    for a, v, _b in groups_by_dn[dn]:
        if a.lower() != 'member':
            continue
        if v.lower() in groups_by_dn:
            people |= resolve_members(v.lower(), groups_by_dn, seen)
        else:
            people.add(v)
    return people


def parse(stream):
    """Yield (dn, [(attr, value, is_b64)]) per entry.

    Orphan continuation lines are dropped: slapcat folds at 76 columns,
    so a continuation is only legitimate after a full-width physical
    line. Password-stripped dumps delete the userPassword line but leave
    its continuations behind - folding those onto the previous attribute
    corrupts it (seen live: uid values with base64 garbage appended)."""
    entry = []
    prev_len = 0
    dropping = False
    for raw in stream:
        line = raw.rstrip('\n')
        if line.startswith('#'):
            continue
        if line == '':
            dropping = False
            prev_len = 0
            if entry:
                yield unfold(entry)
                entry = []
            continue
        if line.startswith(' ') and entry:
            if dropping:
                continue
            if prev_len >= 76:
                entry[-1] += line[1:]
                prev_len = len(line)
            else:
                dropping = True
            continue
        dropping = False
        entry.append(line)
        prev_len = len(line)
    if entry:
        yield unfold(entry)


def unfold(lines):
    dn = None
    attrs = []
    for line in lines:
        if line.startswith('dn:: '):
            dn = base64.b64decode(line[5:]).decode('utf-8', 'replace')
        elif line.startswith('dn: '):
            dn = line[4:]
        elif ':: ' in line:
            attr, value = line.split(':: ', 1)
            attrs.append((attr, value, True))
        elif ': ' in line:
            attr, value = line.split(': ', 1)
            attrs.append((attr, value, False))
    return dn, attrs


def keep_attr(attr):
    a = attr.lower()
    return a in KEEP_ATTRS or a.startswith(KEEP_ATTR_PREFIXES)


def is_seeded_container(dn):
    return bool(SEEDED_RE.match(dn.strip()))


def transform(stream, out):
    kept_dns = set()
    entries = []
    skipped = 0
    for dn, attrs in parse(stream):
        if dn is None:
            continue
        low = dn.lower()
        if any(m in low for m in SKIP_SUBTREE_MARKERS):
            skipped += 1
            continue
        ocs = [v for a, v, b in attrs if a.lower() == 'objectclass']
        # FD service accounts directly under the root (cn=... at the root,
        # and the FD-era users/groups in the root-level ou=people/ou=groups)
        if low.startswith('cn=') and low.count(',dc=') == 2:
            skipped += 1
            continue
        if re.match(r'^(uid|cn)=[^,]+,ou=(people|groups),dc=dreamhack,dc=se$',
                    low):
            skipped += 1
            continue
        if is_seeded_container(dn) or low == 'cn=replicator,dc=dreamhack,dc=se':
            skipped += 1
            continue
        new_ocs = [oc for oc in ocs
                   if not oc.lower().startswith(DROP_CLASS_PREFIXES)]
        if not new_ocs or new_ocs == ['top']:
            skipped += 1
            continue
        # user entries get the dhPerson and ldapPublicKey extensions
        # up front: the ACLs let people edit their own dhtech
        # attributes and ssh keys but never their objectClass, so
        # self-service needs the classes pre-provisioned
        lower_ocs = [oc.lower() for oc in new_ocs]
        if 'posixaccount' in lower_ocs and 'inetorgperson' in lower_ocs:
            if 'dhperson' not in lower_ocs:
                new_ocs.append('dhPerson')
            if 'ldappublickey' not in lower_ocs:
                new_ocs.append('ldapPublicKey')
        new_attrs = [('objectClass', oc, False) for oc in new_ocs]
        new_attrs += [(a, v, b) for a, v, b in attrs
                      if a.lower() != 'objectclass' and keep_attr(a)]
        entries.append((dn, new_attrs))
        kept_dns.add(low)

    # THE TEAMS: index every group, expand the sources to people,
    # drop the source entries, synthesize the canonical 8 (+ the
    # access OU scaffolding)
    groups_by_dn = {
        dn.lower(): attrs for dn, attrs in entries
        if any(a.lower() == 'objectclass' and v == 'groupOfNames'
               for a, v, b in attrs)}
    source_dns = {dn.lower() for dn in groups_by_dn
                  if dn.split(',')[0][3:] in TEAM_SOURCE_CNS}
    team_members = {}
    for cn, parent, gid, desc, sources in TEAMS:
        people = set()
        for sdn in source_dns:
            if sdn.split(',')[0][3:] in sources:
                people |= resolve_members(sdn, groups_by_dn)
        team_members[cn] = people
    entries = [(dn, attrs) for dn, attrs in entries
               if dn.lower() not in source_dns]
    kept_dns -= source_dns
    for ou_dn in TEAM_NEW_OUS:
        entries.append((ou_dn, [
            ('objectClass', 'organizationalUnit', False),
            ('ou', ou_dn.split(',')[0][3:], False)]))
        kept_dns.add(ou_dn.lower())
    for cn, parent, gid, desc, sources in TEAMS:
        dn = 'cn=%s,%s' % (cn, parent)
        attrs = [('objectClass', 'groupOfNames', False),
                 ('objectClass', 'posixGroup', False),
                 ('cn', cn, False),
                 ('gidNumber', str(gid), False),
                 ('description', desc, False)]
        attrs += [('member', m, False)
                  for m in sorted(team_members[cn])]
        entries.append((dn, attrs))
        kept_dns.add(dn.lower())

    # parents before children: slapcat order does not guarantee it
    entries.sort(key=lambda e: e[0].count(','))

    written = 0
    pruned_members = 0
    for dn, attrs in entries:
        out.write('dn: %s\n' % dn)
        is_gon = any(a.lower() == 'objectclass' and v == 'groupOfNames'
                                  for a, v, b in attrs)
        members_out = 0
        for attr, value, is_b64 in attrs:
            if attr.lower() == 'member':
                if value.lower() not in kept_dns:
                    pruned_members += 1
                    continue
                members_out += 1
            sep = ':: ' if is_b64 else ': '
            out.write('%s%s%s\n' % (attr, sep, value))
        if is_gon and members_out == 0:
            # groupOfNames requires at least one member; self-reference is the
            # standard placeholder when every real member was pruned
            out.write('member: %s\n' % dn)
        out.write('\n')
        written += 1
    print('directory-import: %d entries written, %d skipped, '
          '%d dangling member DNs pruned' % (written, skipped, pruned_members),
          file=sys.stderr)


if __name__ == '__main__':
    transform(sys.stdin, sys.stdout)
