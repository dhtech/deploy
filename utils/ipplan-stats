'''


def esc(value):
    return html.escape(str(value), quote=True)


def meta(c):
    return dict(c.execute('SELECT name, value FROM meta_data'))


def cards(c):
    counts = [
        ('hosts', 'SELECT COUNT(*) FROM host'),
        ('networks', 'SELECT COUNT(*) FROM network'),
        ('firewall rules', 'SELECT COUNT(*) FROM firewall_rule'),
        ('services', 'SELECT COUNT(*) FROM service'),
        ('flows', 'SELECT COUNT(*) FROM flow'),
        ('packages', 'SELECT COUNT(DISTINCT name) FROM package'),
    ]
    out = []
    for label, sql in counts:
        out.append('\n  <div class="card"><b>%d</b><span>%s</span></div>'
                   % (c.execute(sql).fetchone()[0], esc(label)))
    return ''.join(out)


def network_rows(c):
    flagged = {}
    for node_id, name in c.execute(
            "SELECT node_id, name FROM option WHERE name IN "
            "('dhcp', 'nat')"):
        flagged.setdefault(node_id, []).append(name)
    rows = []
    for (node_id, name, vlan, v4, v6, gw) in c.execute(
            'SELECT node_id, name, vlan, ipv4_txt, ipv6_txt, '
            'ipv4_gateway_txt FROM network ORDER BY name'):
        hosts = c.execute(
            'SELECT COUNT(*) FROM host WHERE network_id = ?',
            (node_id,)).fetchone()[0]
        usable = 0
        if v4:
            try:
                usable = max(ipaddress.ip_network(v4).num_addresses - 2, 1)
            except ValueError:
                usable = 0
        pct = round(100 * hosts / usable) if usable else 0
        tags = ''.join('<span class="tag">%s</span>' % esc(t)
                       for t in flagged.get(node_id, []))
        rows.append(
            '\n<tr><td>%s%s</td><td>%s</td><td>%s</td><td>%s</td>'
            '<td>%s</td><td class="num">%d</td>'
            '<td><span class="bar"><i style="width:%d%%"></i></span>'
            '%d%%</td></tr>' % (
                esc(name), tags, vlan or '', esc(v4 or ''), esc(v6 or ''),
                esc(gw or ''), hosts, min(pct, 100), pct))
    return ''.join(rows)


def package_rows(c):
    counts = c.execute(
        'SELECT name, COUNT(*) AS n FROM package GROUP BY name '
        'ORDER BY n DESC, name').fetchall()
    top = counts[0][1] if counts else 1
    return ''.join(
        '\n<tr><td>%s</td><td class="num">%d</td>'
        '<td><span class="bar"><i style="width:%d%%"></i></span></td></tr>'
        % (esc(name), n, round(100 * n / top))
        for name, n in counts)


def _masters_and_networks(c):
    """Split network rows: the <DOMAIN>@DREAMHACK rows are the
    supernet masters (#@ blocks), the rest are real networks."""
    masters, networks = [], []
    for row in c.execute(
            'SELECT node_id, name, ipv4_txt, ipv4_gateway_txt '
            'FROM network ORDER BY name'):
        (networks, masters)[row[1].endswith('@DREAMHACK')].append(row)
    return masters, networks


def supernet_hole_rows(c):
    """Free blocks inside each supernet: the master's range minus its
    networks - computed, where prod tracks #-FREE- comments by hand."""
    masters, networks = _masters_and_networks(c)
    rows = []
    for _, name, cidr, _ in masters:
        try:
            supernet = ipaddress.ip_network(cidr)
        except ValueError:
            continue
        domain = name.split('@', 1)[0]
        blocks = [supernet]
        for _, nname, ncidr, _ in networks:
            if nname.split('@', 1)[0] != domain or not ncidr:
                continue
            try:
                child = ipaddress.ip_network(ncidr)
            except ValueError:
                continue
            nxt = []
            for block in blocks:
                if child == block:
                    continue
                if child.subnet_of(block):
                    nxt.extend(block.address_exclude(child))
                elif block.subnet_of(child):
                    continue
                else:
                    nxt.append(block)
            blocks = nxt
        if blocks:
            for block in sorted(blocks):
                rows.append(
                    '\n<tr><td>%s</td><td>%s</td><td>%s</td>'
                    '<td class="num">%d</td></tr>'
                    % (esc(domain), esc(cidr), esc(block),
                       block.num_addresses))
        else:
            rows.append(
                '\n<tr><td>%s</td><td>%s</td>'
                '<td colspan="2" class="full">fully allocated</td></tr>'
                % (esc(domain), esc(cidr)))
    return ''.join(rows)


def _free_ranges(net, used):
    """Gap-walk the usable span: (start, end) int pairs not in used."""
    lo = int(net.network_address) + 1
    hi = int(net.broadcast_address) - 1
    ranges, cursor = [], lo
    for addr in sorted(a for a in used if lo <= a <= hi):
        if addr > cursor:
            ranges.append((cursor, addr - 1))
        cursor = max(cursor, addr + 1)
    if cursor <= hi:
        ranges.append((cursor, hi))
    return ranges


def network_hole_rows(c, limit=6):
    """Unallocated ranges inside each network (gateway, network and
    broadcast count as used) - where the next IP comes from."""
    _, networks = _masters_and_networks(c)
    rows = []
    for node_id, name, cidr, gateway in networks:
        if not cidr:
            continue
        try:
            net = ipaddress.ip_network(cidr)
        except ValueError:
            continue
        if net.num_addresses <= 2:
            continue
        used = {addr for (addr,) in c.execute(
            'SELECT ipv4_addr FROM host WHERE network_id = ? '
            'AND ipv4_addr IS NOT NULL', (node_id,))}
        if gateway:
            used.add(int(ipaddress.ip_address(gateway)))
        ranges = _free_ranges(net, used)
        free = sum(end - start + 1 for start, end in ranges)
        shown = []
        for start, end in ranges[:limit]:
            first = ipaddress.ip_address(start)
            if start == end:
                shown.append(str(first))
            else:
                shown.append('%s &ndash; %s' % (
                    first, ipaddress.ip_address(end)))
        more = len(ranges) - limit
        if more > 0:
            shown.append('&#8230; +%d more' % more)
        rows.append(
            '\n<tr><td>%s</td><td class="num">%d</td>'
            '<td class="ranges">%s</td></tr>'
            % (esc(name), free,
               ', '.join(shown) if shown else
               '<span class="full">none free</span>'))
    return ''.join(rows)


def _heat_cells(total_addrs, base_int, used, names, max_cells=256):
    """Grid cells for one address block: per-address when it fits,
    density-aggregated slices otherwise. Returns HTML <i> cells with
    tooltips (hostname on used addresses)."""
    n = min(total_addrs, max_cells)
    per = total_addrs // n
    used_sorted = sorted(used)
    import bisect
    cells = []
    for i in range(n):
        lo = base_int + i * per
        hi = lo + per - 1
        count = (bisect.bisect_right(used_sorted, hi)
                 - bisect.bisect_left(used_sorted, lo))
        if per == 1:
            addr = ipaddress.ip_address(lo)
            if count:
                label = names.get(lo)
                cells.append('<i class="h4" title="%s%s"></i>' % (
                    esc(addr), esc(' - ' + label if label else '')))
            elif lo in names:   # infra: network/broadcast/gateway
                cells.append('<i class="infra" title="%s - %s"></i>'
                             % (esc(addr), esc(names[lo])))
            else:
                cells.append('<i title="%s free"></i>' % esc(addr))
        else:
            level = 0 if not count else max(
                1, round(4 * count / per))
            cells.append('<i class="h%d" title="%s &ndash; %s: %d/%d used"></i>'
                         % (min(level, 4), ipaddress.ip_address(lo),
                            ipaddress.ip_address(hi), count, per))
    return ''.join(cells)


def heatmap_blocks(c):
    """One heat grid per supernet (density = space covered by its
    networks) and per network (cell = address; hostname tooltips)."""
    masters, networks = _masters_and_networks(c)
    blocks = []
    for _, name, cidr, _ in masters:
        try:
            supernet = ipaddress.ip_network(cidr)
        except ValueError:
            continue
        domain = name.split('@', 1)[0]
        used = set()
        for _, nname, ncidr, _ in networks:
            if nname.split('@', 1)[0] != domain or not ncidr:
                continue
            try:
                child = ipaddress.ip_network(ncidr)
            except ValueError:
                continue
            if child.subnet_of(supernet):
                used.update(range(int(child.network_address),
                                  int(child.broadcast_address) + 1))
        blocks.append(
            '\n<div class="heatblock"><h3>%s supernet %s</h3>'
            '<p>allocation of the master block by its networks</p>'
            '<div class="heat">%s</div></div>'
            % (esc(domain), esc(cidr),
               _heat_cells(supernet.num_addresses,
                           int(supernet.network_address), used, {})))
    for node_id, name, cidr, gateway in networks:
        if not cidr:
            continue
        try:
            net = ipaddress.ip_network(cidr)
        except ValueError:
            continue
        if net.num_addresses <= 2:
            continue
        used, names = set(), {}
        for addr, host in c.execute(
                'SELECT ipv4_addr, name FROM host WHERE network_id = ? '
                'AND ipv4_addr IS NOT NULL', (node_id,)):
            used.add(addr)
            names[addr] = host
        names.setdefault(int(net.network_address), 'network')
        names.setdefault(int(net.broadcast_address), 'broadcast')
        if gateway:
            gw = int(ipaddress.ip_address(gateway))
            if gw not in used:
                names.setdefault(gw, 'gateway')
        blocks.append(
            '\n<div class="heatblock"><h3>%s</h3><p>%s &middot; '
            '%d hosts</p><div class="heat">%s</div></div>'
            % (esc(name), esc(cidr), len(used),
               _heat_cells(net.num_addresses,
                           int(net.network_address), used, names)))
    legend = ('\n<p class="heatlegend">each cell is one address '
              '(aggregated on large blocks); hover for details.'
              '<i></i>free <i class="h4" ></i>allocated '
              '<i class="infra"></i>network/broadcast/gateway</p>')
    return ''.join(blocks) + legend


def recent_changes(diff_dir, limit=5):
    if not diff_dir or not os.path.isdir(diff_dir):
        return ''
    diffs = sorted(
        (f for f in os.listdir(diff_dir)
         if re.fullmatch(r'ipplan-r\d+\.diff', f)),
        key=lambda f: int(f[len('ipplan-r'):-len('.diff')]),
        reverse=True)[:limit]
    if not diffs:
        return ''
    blocks = ['\n<h2>Recent changes</h2>']
    for name in diffs:
        with open(os.path.join(diff_dir, name)) as f:
            body = f.read()
        rev = name[len('ipplan-r'):-len('.diff')]
        blocks.append(
            '\n<details%s><summary>r%s</summary><pre>%s</pre></details>'
            % (' open' if name == diffs[0] else '', esc(rev), esc(body)))
    return ''.join(blocks)


def render(db_path, diff_dir=None):
    conn = sqlite3.connect(db_path)
    c = conn.cursor()
    info = meta(c)
    freezes = ''.join(
        ' <span class="badge warn">%s frozen</span>' % esc(kind)
        for kind in ('apt', 'change')
        if info.get('%s_freeze' % kind) == 'true')
    page = PAGE % {
        'revision': esc(info.get('svn_revision', '?')),
        'event': esc(info.get('current_event', '?')),
        'freeze_badges': freezes,
        'build_time': esc(info.get('build_time', '?')),
        'schema': esc(info.get('schema_version', '?')),
        'tool': esc(info.get('tool_version', '?')),
        'cards': cards(c),
        'networks': network_rows(c),
        'packages': package_rows(c),
        'heatmap': heatmap_blocks(c),
        'supernet_holes': supernet_hole_rows(c),
        'network_holes': network_hole_rows(c),
        'changes': recent_changes(diff_dir),
    }
    conn.close()
    return page


def main():
    args = [a for a in sys.argv[1:] if not a.startswith('--')]
    diff_dir = None
    for arg in sys.argv[1:]:
        if arg.startswith('--diff-dir'):
            diff_dir = arg.split('=', 1)[1] if '=' in arg else None
    if not args or len(args) > 2:
        print(__doc__, file=sys.stderr)
        return 1
    page = render(args[0], diff_dir)
    if len(args) == 2:
        with open(args[1] + '.new', 'w') as f:
            f.write(page)
        os.replace(args[1] + '.new', args[1])
    else:
        sys.stdout.write(page)
    return 0


if __name__ == '__main__':
    sys.exit(main())
