# Prod gate parity (verify.py): what a line may look like. The
# firewall letters ride both lists; the gen-3 grammar adds
# webname/expose/addr/client (hosts) and gw/native/client (networks).
_FIREWALL_FLAGS = ('c', 's', 'l', 'p', 'w')
HOST_FLAGS = frozenset((
    'mac', 'ipv4f', 'ipv4r', 'ipv6f', 'ipv6r', 'swconf', 'env',
    'rncd', 'layer', 'pkg', 'os', 'nodns', 'ci', 'deploy', 'nat',
    'silence', 'none', 'master', 'no-snmp', 'no-ssh',
    'webname', 'expose', 'addr', 'client') + _FIREWALL_FLAGS)
NETWORK_FLAGS = frozenset((
    'dhcp', 'deploy', 'vrf', 'reserved', 'resv', 'nat', 'othernet',
    'dhcp-max-lease-time', 'dhcp-default-lease-time',
    'dhcp-domain-name-servers', 'dhcp-tftp', 'acloutv4', 'aclinv4',
    'acloutv6', 'aclinv6', 'int', 'techl', 'techw', 'sw', 'shnet',
    'pkg', 'vdom', 'flow', 'k8s', 'none', 'no-acl', 'no-akv',
    'gw', 'native', 'client', 'wg') + _FIREWALL_FLAGS)
VALID_OSES = frozenset((
    'esxi', 'junos', 'ios', 'iosxr', 'nxos', 'prime', 'wlc',
    'windows', 'vcenter', 'debian', 'c7000', 'ubuntu', 'atomic',
    'ucs', 'mse', 'ds', 'vip', 'netscaler', 'zos', 'zvm', 'onl',
    'custom', 'ilo', 'ubmc', 'ipmi', 'rasbian', 'fos', 'pve'))
# prod's rule minus the three-label minimum (lab hosts are x.test)
HOSTNAME_RE = re.compile(
    r'^([a-z0-9-]+\.)+(se|ch|local|com|net|org|nu|test)$')
VLAN_RESERVED = (1002, 1003, 1004, 1005)
# canonical tab-8 column starts per line kind (prod's verify.py)
ALIGN_MASTER = (24,)
ALIGN_HOST = (48, 96)
ALIGN_NETWORK = (48, 72, 88, 96)


class BuildError(Exception):
    """All validation errors of a build, reported at once."""

    def __init__(self, errors):
        super().__init__('\n'.join(errors))
        self.errors = errors


Network = collections.namedtuple('Network', (
    'node_id', 'name', 'short_name', 'vlan', 'terminator',
    'ipv4', 'ipv6', 'ipv4_gateway', 'ipv6_gateway', 'line'))
Host = collections.namedtuple('Host', (
    'node_id', 'name', 'ipv4', 'ipv6', 'network_id', 'line'))


class Model:
    """The parsed topology: one shared node id space, insertion order
    identical to gen-2 (networks and hosts numbered as encountered)."""

    def __init__(self):
        self.next_node = 0
        self.networks = []
        self.hosts = []
        self.options = []   # (node_id, name, value)
        self.errors = []

    def node(self):
        self.next_node += 1
        return self.next_node


def split_value(string):
    """Split a comma list but preserve parenthesized pkg options:
    'a,b(x=1,y=2),c' -> ['a', 'b(x=1,y=2)', 'c']."""
    result = []
    level = 0
    buf = []
    for entry in string.split(','):
        level += entry.count('(') - entry.count(')')
        buf.append(entry)
        if level == 0:
            result.append(','.join(buf))
            buf = []
    return result


class Parser:
    """One ipplan text file: #@ master pair sets the domain and v6
    base, network lines open a network, #$ lines attach hosts to the
    most recent network. Gen-2 processor.py grammar."""

    def __init__(self, model, path):
        self.model = model
        self.path = path
        self.domain = None
        self.v6_base = None
        self.pending_master = None
        self.current_network = None

    def fail(self, lineno, message):
        self.model.errors.append('%s:%d: %s' % (self.path, lineno, message))

    def style(self, lineno, line, columns):
        """Prod's column discipline: tabs only between fields, every
        field flush on its tab-8 column. Non-fatal - the line still
        parses so later checks get their say too."""
        line = line.rstrip('\n')
        if '  ' in line:
            self.fail(lineno, 'more than one space in a row - '
                      'use tabs (tabsize 8)')
            return
        if line.startswith(' ') or '\t ' in line:
            self.fail(lineno, 'column starts with a space')
            return
        # prod tolerates a trailing space inside a field and a bare
        # tab at end of line (43 rows in the dhb26 corpus); gen-3
        # rejects them - reformat scrubs them for free
        if ' \t' in line or line.endswith((' ', '\t')):
            self.fail(lineno, 'trailing whitespace in a field')
            return
        starts = []
        col = 0
        boundary = True
        for char in line:
            if char == '\t':
                col += 8 - col % 8
                boundary = True
            else:
                if boundary:
                    starts.append(col)
                    boundary = False
                col += 1
        if starts != [0] + list(columns):
            self.fail(lineno, 'alignment is off: columns start at %s, '
                      'want %s (tabsize 8, make it look nice)'
                      % (starts[1:], list(columns)))

    def options(self, node_id, raw):
        for option in raw.split(';'):
            name, sep, value = option.partition('=')
            if not name:
                continue
            if sep:
                for entry in split_value(value):
                    self.model.options.append((node_id, name, entry))
            else:
                self.model.options.append((node_id, name, '1'))

    def option_of(self, node_id, name):
        for nid, oname, value in self.model.options:
            if nid == node_id and oname == name:
                return value
        return None

    def master(self, tokens, lineno):
        if len(tokens) != 3:
            self.fail(lineno, 'master line needs exactly '
                      'IPV[4|6]-<DOMAIN>-NET and a network')
            return
        if self.pending_master is None:
            if not re.match(r'IPV4-[A-Z0-9]+-NET$', tokens[1]):
                self.fail(lineno, 'master pair must start with '
                          'IPV4-<DOMAIN>-NET, got %r' % tokens[1])
                return
            self.pending_master = (tokens, lineno)
            self.domain = tokens[1].split('-')[1]
            return
        # second line of the pair: the IPv6 master
        v4_tokens, v4_lineno = self.pending_master
        self.pending_master = None
        if not re.match(r'IPV6-[A-Z0-9]+-NET$', tokens[1]):
            self.fail(lineno, 'expected IPV6-%s-NET after the IPv4 '
                      'master, got %r' % (self.domain, tokens[1]))
            return
        try:
            net = ipaddress.ip_network(v4_tokens[2])
        except ValueError as error:
            self.fail(v4_lineno, str(error))
            return
        self.v6_base = tokens[2].split('::', 1)[0]
        v6_prefix = tokens[2].split('/', 1)[1]
        node_id = self.model.node()
        self.model.networks.append(Network(
            node_id=node_id,
            name='%s@DREAMHACK' % self.domain, short_name='DREAMHACK',
            vlan=0, terminator='', ipv4=net,
            ipv6=(tokens[2], v6_prefix),
            ipv4_gateway=net.network_address + 1,
            ipv6_gateway='%s::1' % self.v6_base, line=v4_lineno))

    def flush_master(self):
        """An IPv4 master with no IPv6 pair (gen-3 extension: a site
        without v6). No network row, no v6 derivation."""
        if self.pending_master is None:
            return
        v4_tokens, v4_lineno = self.pending_master
        self.pending_master = None
        try:
            net = ipaddress.ip_network(v4_tokens[2])
        except ValueError as error:
            self.fail(v4_lineno, str(error))
            return
        node_id = self.model.node()
        self.model.networks.append(Network(
            node_id=node_id,
            name='%s@DREAMHACK' % self.domain, short_name='DREAMHACK',
            vlan=0, terminator='', ipv4=net, ipv6=None,
            ipv4_gateway=net.network_address + 1,
            ipv6_gateway=None, line=v4_lineno))

    def network(self, tokens, lineno):
        self.flush_master()
        if self.domain is None:
            self.fail(lineno, 'network line before any #@ master')
            return
        if len(tokens) != 5:
            self.fail(lineno, 'network line needs exactly name, net, '
                      'terminator, vlan, options (use "none" for no '
                      'options)')
            return
        short_name = tokens[0]
        if short_name != short_name.upper():
            self.fail(lineno, 'network name %s is not upper case'
                      % short_name)
        try:
            net = ipaddress.ip_network(tokens[1])
        except ValueError as error:
            self.fail(lineno, str(error))
            return
        terminator = tokens[2]
        if terminator != terminator.upper():
            self.fail(lineno, 'terminator name %s is not upper case'
                      % terminator)
        if tokens[3] == '-':
            vlan = None
        elif not tokens[3].isdigit():
            self.fail(lineno, 'non-numeric VLAN %r' % tokens[3])
            return
        else:
            vlan = int(tokens[3])
            if not 1 <= vlan <= 4094 or vlan in VLAN_RESERVED:
                self.fail(lineno, 'VLAN %d out of range 1-4094 or '
                          'reserved 1002-1005' % vlan)
                return
        if 'none' in tokens[4].split(';') and tokens[4] != 'none':
            self.fail(lineno, "option 'none' is only valid alone")
        node_id = self.model.node()
        if vlan and self.v6_base:
            ipv6 = ('%s:%d::/64' % (self.v6_base, vlan), '64')
            ipv6_gateway = '%s:%d::1' % (self.v6_base, vlan)
        else:
            ipv6 = None
            ipv6_gateway = None
        network = Network(
            node_id=node_id,
            name='%s@%s' % (self.domain, short_name),
            short_name=short_name, vlan=vlan, terminator=terminator,
            ipv4=net, ipv6=ipv6,
            ipv4_gateway=net.network_address + 1,
            ipv6_gateway=ipv6_gateway, line=lineno)
        self.model.networks.append(network)
        if len(tokens) > 4:
            self.options(node_id, tokens[4])
        # gen-3 extension: gw= overrides the computed gateway
        gw = self.option_of(node_id, 'gw')
        if gw is not None:
            network = network._replace(
                ipv4_gateway=ipaddress.ip_address(gw))
            self.model.networks[-1] = network
        self.current_network = network

    def host(self, tokens, lineno):
        self.flush_master()
        if self.current_network is None:
            self.fail(lineno, 'host line before any network line')
            return
        if len(tokens) != 4:
            self.fail(lineno, 'host line needs exactly name, address, '
                      'options (use "none" for no options)')
            return
        name = tokens[1]
        ip = tokens[2]
        if name != name.lower():
            self.fail(lineno, 'hostname %s is not lower case' % name)
        elif not HOSTNAME_RE.match(name):
            self.fail(lineno, 'hostname %s is not a valid fqdn in an '
                      'allowed domain' % name)
        if 'none' in tokens[3].split(';') and tokens[3] != 'none':
            self.fail(lineno, "option 'none' is only valid alone")
        vlan = self.current_network.vlan
        if '.' in ip:
            ipv4 = ip
            # a host belongs to the network SECTION it is written
            # under - an address outside that network is a misfiled
            # line (parse-time attachment drives v6 derivation and
            # consumers; the pve-under-OUTSIDE incident). Hard fail:
            # the pre-commit gate must reject it.
            try:
                in_net = (ipaddress.ip_address(ip)
                          in self.current_network.ipv4)
            except ValueError:
                self.fail(lineno, 'unparseable host address %s' % ip)
                return
            if not in_net:
                self.fail(lineno, 'host %s (%s) is outside its network '
                          'section %s (%s) - move the line under the '
                          'right network' % (name, ip,
                                             self.current_network.short_name,
                                             self.current_network.ipv4))
                return
            ipv6 = None
            if vlan and self.v6_base:
                ipv6 = '%s:%d::%d' % (self.v6_base, vlan,
                                      int(ip.rsplit('.', 1)[1]))
        else:
            ipv4 = None
            ipv6 = ip
            if vlan and self.v6_base and ip.startswith('::'):
                ipv6 = '%s:%d%s' % (self.v6_base, vlan, ip)
        node_id = self.model.node()
        self.model.hosts.append(Host(
            node_id=node_id, name=name, ipv4=ipv4, ipv6=ipv6,
            network_id=self.current_network.node_id, line=lineno))
        if len(tokens) > 3:
            self.options(node_id, tokens[3])

    def parse(self):
        with open(self.path) as f:
            for lineno, line in enumerate(f, 1):
                tokens = line.split()
                if not tokens:
                    continue
                if tokens[0] == '#@':
                    self.style(lineno, line, ALIGN_MASTER)
                    self.master(tokens, lineno)
                elif tokens[0] == '#$':
                    self.style(lineno, line, ALIGN_HOST)
                    self.host(tokens, lineno)
                elif re.match(r'^[A-Z]', tokens[0]):
                    self.style(lineno, line, ALIGN_NETWORK)
                    self.network(tokens, lineno)
                elif not tokens[0].startswith('#'):
                    self.fail(lineno, 'unrecognized line (network '
                              'names are upper case)')
        self.flush_master()


def merge(paths):
    """Merge manifest parts at the top level; duplicate keys are a
    build error so no part can silently override another."""
    manifest = {}
    for path in paths:
        with open(path) as f:
            part = yaml.safe_load(f) or {}
        if not isinstance(part, dict):
            sys.exit('%s: not a yaml mapping' % path)
        for key in part:
            if key in manifest:
                sys.exit('%s: top-level key %r already defined in an '
                         'earlier part' % (path, key))
        manifest.update(part)
    return manifest


def read_currentevent(path):
    """currentevent's key=value lines. Prod has one line today;
    gen-3 adds apt_freeze and change_freeze."""
    values = {'currentevent': None,
              'apt_freeze': 'false', 'change_freeze': 'false'}
    with open(path) as f:
        for line in f:
            key, sep, value = line.strip().partition('=')
            if sep and key:
                values[key] = value
    if not values['currentevent']:
        sys.exit('%s: no currentevent= line' % path)
    return values


def ipplan_files(root, current_event):
    """The build is always sites/* + the currentevent-selected event;
    a missing event file means no event topology (teardown)."""
    files = sorted(glob.glob(
        os.path.join(root, 'allevents', 'colo', '*', 'ipplan')))
    if not files:
        sys.exit('%s: no site ipplan files under allevents/colo/' % root)
    event = os.path.join(root, current_event, 'core', 'ipplan')
    if os.path.exists(event):
        files.append(event)
    return files


def parse_all(paths):
    model = Model()
    for path in paths:
        Parser(model, path).parse()
    return model


def resolve(model, manifest):
    """Materialize the implied pkg set into host options so the option
    and package tables (and every consumer) see ONE truth: network pkgs
    inherit to their hosts, manifest defaults apply per os, and a -pkg
    blacklist beats everything (gen-2 packages.py semantics)."""
    by_node = collections.defaultdict(list)
    for node_id, name, value in model.options:
        by_node[node_id].append((name, value))

    def values(node_id, name):
        return [v for n, v in by_node[node_id] if n == name]

    defaults = manifest.get('default') or {}
    network_ids = {n.node_id for n in model.networks}
    for host in model.hosts:
        have = values(host.node_id, 'pkg')
        names = {v.split('(', 1)[0].lstrip('-') for v in have}
        added = []
        # network pkg options inherit to the network's hosts
        for value in values(host.network_id, 'pkg'):
            if value.split('(', 1)[0].lstrip('-') not in names:
                added.append(value)
                names.add(value.split('(', 1)[0].lstrip('-'))
        # manifest defaults by os, unless the host opted out
        if '-default' not in have:
            osname = next(iter(values(host.node_id, 'os')), None)
            wanted = (list(defaults.get(osname, []))
                      + list(defaults.get('all', [])))
            for pkg in wanted:
                if pkg.split('(', 1)[0] not in names:
                    added.append(pkg)
                    names.add(pkg.split('(', 1)[0])
        for value in added:
            model.options.append((host.node_id, 'pkg', value))
            by_node[host.node_id].append(('pkg', value))

    # blacklist: a -pkg row deletes the pkg (and itself) on that node
    blacklisted = {(nid, value[1:]) for nid, name, value in model.options
                   if name == 'pkg' and value.startswith('-')
                   and value != '-default'}
    if blacklisted:
        model.options = [
            (nid, name, value) for nid, name, value in model.options
            if not (name == 'pkg'
                    and (nid, value.split('(', 1)[0].lstrip('-'))
                    in blacklisted)]
    model.options = [
        (nid, name, value) for nid, name, value in model.options
        if not (name == 'pkg' and value == '-default')]
    del network_ids  # networks keep their raw options untouched


def validate(model, manifest=None):
    """Structural validation; every failure reported, none silently
    dropped. Duplicate hosts/networks are build failures (the UNIQUE
    indexes would also catch them - this names the lines). With a
    manifest, pkg names are checked against it (the gate path); the
    manifest-less call skips only that."""
    seen = {}
    for host in model.hosts:
        for key in [('host', host.name)] + (
                [('ip', host.ipv4)] if host.ipv4 else []):
            if key in seen:
                model.errors.append(
                    'line %d: duplicate %s %s (first at line %d)'
                    % (host.line, key[0], key[1], seen[key]))
            else:
                seen[key] = host.line
    names = {}
    for network in model.networks:
        if network.name in names:
            model.errors.append(
                'line %d: duplicate network %s (first at line %d)'
                % (network.line, network.name, names[network.name]))
        else:
            names[network.name] = network.line

    nets = {n.node_id: n for n in model.networks}
    hosts = {h.node_id: h for h in model.hosts}

    # prod verify parity: only known flag keys, known OSes, and pkg
    # names the manifest declares - a typo'd option must die here, not
    # sit in the db as a silent no-op
    known_pkgs = None
    if manifest is not None:
        known_pkgs = {key.split('(', 1)[0]
                      for key in (manifest.get('packages') or {})}
    for nid, name, value in model.options:
        host = hosts.get(nid)
        net = None if host else nets.get(nid)
        line = host.line if host else (net.line if net else 0)
        allowed = HOST_FLAGS if host else NETWORK_FLAGS
        if name not in allowed:
            model.errors.append('line %d: unknown flag %s'
                                % (line, name))
            continue
        if name == 'os' and value not in VALID_OSES:
            model.errors.append('line %d: unknown OS %s'
                                % (line, value))
        if name == 'pkg' and value and value != '-default':
            pkg = value.split('(', 1)[0].lstrip('-')
            if not pkg:
                continue
            if '-' in pkg:
                model.errors.append(
                    'line %d: package name may not contain dashes: %s'
                    % (line, pkg))
            elif known_pkgs is not None and pkg not in known_pkgs:
                model.errors.append('line %d: no such package %s'
                                    % (line, pkg))

    # overlapping network lines (prod counts every covered IP; same
    # effect). Site masters (vlan 0) deliberately span their networks.
    real = [n for n in model.networks if n.vlan != 0]
    for index, a in enumerate(real):
        for b in real[index + 1:]:
            if a.ipv4.overlaps(b.ipv4):
                model.errors.append(
                    'line %d: network %s (%s) overlaps %s (%s, line '
                    '%d)' % (b.line, b.name, b.ipv4, a.name, a.ipv4,
                             a.line))

    # expose=EXT:INT (router DNAT data): malformed pairs and duplicate
    # external ports within a site are build failures - the gate is
    # where a colliding forward should die, not the router
    seen_expose = {}
    for nid, name, value in model.options:
        if name != 'expose':
            continue
        host = hosts.get(nid)
        line = host.line if host else 0
        match = re.fullmatch(r'(\d{1,5}):(\d{1,5})', value)
        if not match or not all(
                1 <= int(g) <= 65535 for g in match.groups()):
            model.errors.append(
                'line %d: bad expose %r (want EXTPORT:INTPORT, '
                '1-65535)' % (line, value))
            continue
        net = nets.get(host.network_id) if host else None
        domain = net.name.split('@', 1)[0] if net else ''
        key = (domain, int(match.group(1)))
        if key in seen_expose:
            model.errors.append(
                'line %d: expose port %s already used in site %s '
                '(first at line %d)' % (line, match.group(1),
                                        domain or '?', seen_expose[key]))
        else:
            seen_expose[key] = line
    if model.errors:
        raise BuildError(model.errors)


def db_state(c):
    """Row sets per table, id columns excluded so a renumbered build
    is not noise - the input of the build-to-build diff (gen-2 parity:
    ipplan2sqlite lib/diff.py)."""
    state = {}
    c.execute("SELECT name FROM sqlite_master WHERE type = 'table'")
    for (table,) in c.fetchall():
        if table in ('meta_data', 'sqlite_sequence'):
            continue
        c.execute('PRAGMA table_info(%s)' % table)
        columns = [row[1] for row in c.fetchall() if 'id' not in row[1]]
        if columns:
            c.execute('SELECT %s FROM %s' % (', '.join(columns), table))
            state[table] = set(c.fetchall())
        else:
            state[table] = set()
    return state


def format_diff(before, after, limit=50):
    """The change report between two builds: per-table +/- rows,
    capped per table. Printed when a build overwrites a previous db,
    and by the post-commit publisher so the committer sees what the
    commit actually changed."""
    lines = []
    for table in sorted(set(before) | set(after)):
        added = after.get(table, set()) - before.get(table, set())
        removed = before.get(table, set()) - after.get(table, set())
        if not added and not removed:
            continue
        lines.append('%s: +%d -%d' % (table, len(added), len(removed)))
        for row in sorted(added, key=repr)[:limit]:
            lines.append('  + %s' % (row,))
        for row in sorted(removed, key=repr)[:limit]:
            lines.append('  - %s' % (row,))
    return lines


def create_schema(c):
    """Prod's schema verbatim (gen-2 tables.py) + gen-3 additions and
    the writer-side hardening indexes."""
    c.executescript('''
        PRAGMA foreign_keys = ON;
        CREATE TABLE node(id INTEGER PRIMARY KEY AUTOINCREMENT);
        CREATE TABLE host(
            node_id INTEGER, name TEXT,
            ipv4_addr INTEGER, ipv4_addr_txt TEXT, ipv6_addr_txt TEXT,
            network_id INTEGER,
            FOREIGN KEY (node_id) REFERENCES node (id),
            FOREIGN KEY (network_id) REFERENCES node (id));
        CREATE TABLE network(
            node_id INTEGER, name TEXT, short_name TEXT, vlan INTEGER,
            terminator TEXT,
            ipv4 INTEGER, ipv4_txt TEXT, ipv6_txt TEXT,
            ipv4_netmask INTEGER, ipv4_netmask_txt TEXT,
            ipv6_netmask_txt TEXT,
            ipv4_gateway INTEGER, ipv4_gateway_txt TEXT,
            ipv6_gateway_txt TEXT,
            ipv4_netmask_dec INTEGER, ipv6_capable INTEGER,
            FOREIGN KEY (node_id) REFERENCES node (id));
        CREATE TABLE option(
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            node_id INTEGER, name TEXT, value TEXT,
            FOREIGN KEY (node_id) REFERENCES node (id));
        CREATE TABLE package(
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            node_id INTEGER, name TEXT, option TEXT,
            FOREIGN KEY (node_id) REFERENCES node (id));
        CREATE TABLE service(
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            name TEXT, description TEXT, dst_ports TEXT, src_ports TEXT);
        CREATE TABLE flow(
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            name TEXT, description TEXT);
        CREATE TABLE firewall_rule(
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            from_node_id INTEGER, to_node_id INTEGER,
            service_id INTEGER, flow_id INTEGER,
            is_ipv4 BOOLEAN, is_ipv6 BOOLEAN,
            FOREIGN KEY (from_node_id) REFERENCES node (id),
            FOREIGN KEY (to_node_id) REFERENCES node (id),
            FOREIGN KEY (service_id) REFERENCES service (id),
            FOREIGN KEY (flow_id) REFERENCES flow (id));
        CREATE TABLE table_coordinates(
            name TEXT, hall TEXT, x1 INTEGER, x2 INTEGER, y1 INTEGER,
            y2 INTEGER, x_start INTEGER, y_start INTEGER, width INTEGER,
            height INTEGER, horizontal INTEGER);
        CREATE TABLE switch_coordinates(
            name TEXT, x INTEGER, y INTEGER, table_name TEXT);
        CREATE TABLE hall_positions(name TEXT, x INTEGER, y INTEGER);
        CREATE TABLE meta_data(name TEXT, value TEXT);
        CREATE TABLE package_spec(name TEXT PRIMARY KEY, spec TEXT);

        CREATE VIEW node_any AS
            SELECT node_id, name, ipv4_addr_txt AS ipv4_txt,
                   ipv6_addr_txt AS ipv6_txt
            FROM host
            UNION SELECT node_id, name, ipv4_txt, ipv6_txt FROM network;
        CREATE VIEW firewall_rule_ip_level AS
            SELECT fw.is_ipv4, fw.is_ipv6,
                   f.name AS from_node_name, f.ipv4_txt AS from_ipv4,
                   f.ipv6_txt AS from_ipv6,
                   t.name AS to_node_name, t.ipv4_txt AS to_ipv4,
                   t.ipv6_txt AS to_ipv6,
                   fl.name AS flow_name, s.name AS service_name,
                   s.description AS service_description,
                   s.dst_ports AS service_dst_ports,
                   s.src_ports AS service_src_ports
            FROM node_any f, node_any t, service s, firewall_rule fw,
                 flow fl
            WHERE s.id = fw.service_id AND fl.id = fw.flow_id
              AND f.node_id = fw.from_node_id
              AND t.node_id = fw.to_node_id;

        CREATE UNIQUE INDEX idx_host_name ON host (name);
        CREATE UNIQUE INDEX idx_host_ipv4 ON host (ipv4_addr_txt);
        CREATE UNIQUE INDEX idx_network_name ON network (name);
        CREATE INDEX idx_option_node ON option (node_id, name);
        CREATE INDEX idx_package_node ON package (node_id);
        CREATE INDEX idx_fw_to ON firewall_rule (to_node_id);
    ''')
    c.executescript('''CREATE VIEW active_switch AS
        SELECT n.node_id, h.ipv4_addr_txt, n.ipv4_txt,
               substr(o.value, 1, 1) AS sw,
               LOWER(n.short_name) || '-' || substr(o.value, 1, 1)
                   || '.event.dreamhack.local' AS switch_name
        FROM option o, network n, host h
        WHERE h.name = switch_name AND o.name = 'sw'
          AND n.node_id = o.node_id AND sw <> ''
        UNION
        SELECT n.node_id, h.ipv4_addr_txt, n.ipv4_txt,
               substr(o.value, 2, 1) AS sw,
               LOWER(n.short_name) || '-' || substr(o.value, 2, 1)
                   || '.event.dreamhack.local' AS switch_name
        FROM option o, network n, host h
        WHERE h.name = switch_name AND o.name = 'sw'
          AND n.node_id = o.node_id AND sw <> ''
        UNION
        SELECT n.node_id, h.ipv4_addr_txt, n.ipv4_txt,
               substr(o.value, 3, 1) AS sw,
               LOWER(n.short_name) || '-' || substr(o.value, 3, 1)
                   || '.event.dreamhack.local' AS switch_name
        FROM option o, network n, host h
        WHERE h.name = switch_name AND o.name = 'sw'
          AND n.node_id = o.node_id AND sw <> '';''')


def emit_topology(model, c):
    for _ in range(model.next_node):
        c.execute('INSERT INTO node VALUES (NULL)')
    for n in model.networks:
        net = n.ipv4
        c.execute(
            'INSERT INTO network VALUES '
            '(?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)',
            (n.node_id, n.name, n.short_name, n.vlan, n.terminator,
             int(net.network_address), str(net),
             n.ipv6[0] if n.ipv6 else None,
             int(net.netmask), str(net.netmask),
             n.ipv6[1] if n.ipv6 else None,
             int(n.ipv4_gateway), str(n.ipv4_gateway),
             n.ipv6_gateway, net.prefixlen,
             1 if n.ipv6 or n.vlan == 0 else 0))
    for h in model.hosts:
        c.execute(
            'INSERT INTO host VALUES (?, ?, ?, ?, ?, ?)',
            (h.node_id, h.name,
             int(ipaddress.ip_address(h.ipv4)) if h.ipv4 else None,
             h.ipv4, h.ipv6, h.network_id))
    for node_id, name, value in model.options:
        c.execute('INSERT INTO option VALUES (NULL, ?, ?, ?)',
                  (node_id, name, value))


def emit_packages(model, c):
    """The package table: the same resolved pkg set as the option
    rows, name and parenthesized options split (gen-2 packages.py
    output shape). One parse, two projections - they cannot disagree."""
    per_node = collections.defaultdict(
        lambda: collections.defaultdict(list))
    for node_id, name, value in model.options:
        if name != 'pkg':
            continue
        match = re.match(r'^(.*?)\((.*)\)$', value)
        if match:
            per_node[node_id][match.group(1)].extend(
                match.group(2).split(','))
        else:
            per_node[node_id][value]
    for node_id in sorted(per_node):
        for pkg, options in sorted(per_node[node_id].items()):
            for option in options or [None]:
                c.execute('INSERT INTO package VALUES (NULL, ?, ?, ?)',
                          (node_id, pkg, option))


def emit_manifest(manifest, model, c):
    """Services and flows with prod ids; the full package specs and
    globals/apps as gen-3 additions. Site names (network domain
    lowercased) are auto-registered as flows: they are the default
    flow of every spec, and the ip-level view needs the join to
    resolve."""
    service_ids = {}
    for name, spec in sorted((manifest.get('services') or {}).items()):
        spec = spec or {}
        c.execute('INSERT INTO service VALUES (NULL, ?, ?, ?, ?)',
                  (name, spec.get('description', name),
                   ','.join(spec.get('destport', [])),
                   ','.join(spec.get('sourceport', [])) or None))
        service_ids[name] = c.lastrowid
    sites = sorted({n.name.split('@', 1)[0].lower()
                    for n in model.networks})
    flow_ids = {}
    for name in list(manifest.get('flows') or []) + [
            s for s in sites if s not in (manifest.get('flows') or [])]:
        c.execute('INSERT INTO flow VALUES (NULL, ?, ?)', (name, name))
        flow_ids[name] = c.lastrowid
    for name, spec in sorted((manifest.get('packages') or {}).items()):
        c.execute('INSERT INTO package_spec VALUES (?, ?)',
                  (name, json.dumps(spec or {}, sort_keys=True)))
    for key in ('globals', 'apps'):
        if manifest.get(key) is not None:
            c.execute('INSERT INTO meta_data VALUES (?, ?)',
                      ('manifest_' + key, json.dumps(manifest[key])))
    return service_ids, flow_ids


def emit_firewall(manifest, model, c, service_ids, flow_ids, db_path):
    """Precompute the flow pairings in prod's node-id form; consumers
    read the firewall_rule_ip_level view. The same gen-3 flows engine
    that used to run at ENC time runs once here."""
    metadata.DB_FILE = db_path
    node_of = {h.name: h.node_id for h in model.hosts}
    has_v6 = {h.name: bool(h.ipv6) for h in model.hosts}
    # networks can be flow CLIENTS (client= on the network line)
    for n in model.networks:
        node_of.setdefault(n.name, n.node_id)
        has_v6.setdefault(n.name, bool(n.ipv6))
    rules = 0
    for host in sorted(h.name for h in model.hosts):
        for client, flow, service in flows.firewall_pairs(host, manifest):
            c.execute(
                'INSERT INTO firewall_rule VALUES (NULL, ?, ?, ?, ?, ?, ?)',
                (node_of[client], node_of[host],
                 service_ids[service], flow_ids[flow],
                 1, 1 if has_v6[client] and has_v6[host] else 0))
            rules += 1
    return rules


def build(ipplan_root, manifest_paths, db_path, svn_revision=None):
    manifest = merge(manifest_paths)
    current = read_currentevent(os.path.join(ipplan_root, 'currentevent'))
    files = ipplan_files(ipplan_root, current['currentevent'])
    model = parse_all(files)
    resolve(model, manifest)
    validate(model, manifest)

    import sqlite3
    before = None
    if os.path.exists(db_path):
        try:
            prev = sqlite3.connect(db_path)
            before = db_state(prev.cursor())
            prev.close()
        except sqlite3.Error:
            before = None
        os.unlink(db_path)
    conn = sqlite3.connect(db_path)
    c = conn.cursor()
    create_schema(c)
    emit_topology(model, c)
    emit_packages(model, c)
    service_ids, flow_ids = emit_manifest(manifest, model, c)
    conn.commit()
    rules = emit_firewall(manifest, model, c, service_ids, flow_ids,
                          db_path)
    c.executemany('INSERT INTO meta_data VALUES (?, ?)', [
        ('schema_version', SCHEMA_VERSION),
        ('tool_version', TOOL_VERSION),
        ('svn_revision', str(svn_revision or 0)),
        ('build_time', datetime.datetime.now(
            datetime.timezone.utc).isoformat(timespec='seconds')),
        ('current_event', current['currentevent']),
        ('apt_freeze', current['apt_freeze']),
        ('change_freeze', current['change_freeze']),
    ])
    conn.commit()
    if before is not None:
        for line in format_diff(before, db_state(c)):
            print(line)
    conn.close()
    print('ipplan compiled: %d networks, %d hosts, %d services, '
          '%d flows, %d packages, %d firewall rules (event %s)' % (
              len(model.networks), len(model.hosts),
              len(service_ids), len(flow_ids),
              len(manifest.get('packages') or {}), rules,
              current['currentevent']))


def reformat(text):
    """Re-tab data lines to the canonical columns (the exact layout
    style() accepts): host 48/96, network 48/72/88/96, master 24.
    Comments and blanks pass through; a field too long for its column
    is left flush for the checker to flag."""
    out = []
    for line in text.split('\n'):
        tokens = line.split()
        fields = columns = None
        if tokens:
            if tokens[0] == '#@' and len(tokens) > 2:
                fields = ['#@ ' + tokens[1]] + tokens[2:]
                columns = ALIGN_MASTER
            elif tokens[0] == '#$' and len(tokens) > 2:
                fields = ['#$ ' + tokens[1]] + tokens[2:]
                columns = ALIGN_HOST
            elif re.match(r'^[A-Z]', line):
                fields = tokens
                columns = ALIGN_NETWORK
        if fields is None:
            out.append(line)
            continue
        built = fields[0]
        col = len(built)
        for field in fields[1:]:
            target = columns[0] if columns else col + 1
            columns = columns[1:]
            built += '\t'
            col += 8 - col % 8
            while col < target:
                built += '\t'
                col += 8 - col % 8
            built += field
            col += len(field)
        out.append(built)
    return '\n'.join(out)


def main():
    if len(sys.argv) == 3 and sys.argv[1] == '--reformat':
        with open(sys.argv[2]) as f:
            sys.stdout.write(reformat(f.read()))
        return
    parser = argparse.ArgumentParser(
        description='compile ipplan text files + the manifest into '
                    'ipplan.db')
    parser.add_argument('--ipplan-root', required=True,
                        help='svn-tree root: allevents/colo/*/ipplan, '
                             '<event>/core/ipplan, currentevent')
    parser.add_argument('--manifest', action='append', required=True,
                        help='manifest part (repeat: manifest.yaml, '
                             'appstore.yaml)')
    parser.add_argument('--svn-revision',
                        help='revision stamp for the meta_data row')
    parser.add_argument('db', help='output database')
    args = parser.parse_args()
    try:
        build(args.ipplan_root, args.manifest, args.db,
              args.svn_revision)
    except BuildError as error:
        for line in error.errors:
            print(line, file=sys.stderr)
        sys.exit(1)


if __name__ == '__main__':
    main()
