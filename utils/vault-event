#!/bin/sh
# Event lifecycle for the secret store (gen-3 mount-event): every event
# gets its own identity - a services-<event> and a mgmt-<event> mount -
# and the team policies are REGENERATED so the new event is writable
# while every past event stays readable (gen-2 semantics, but derived
# instead of hand-edited).
#
# Run on the vault host with BAO_ADDR/BAO_CACERT/BAO_TOKEN set:
#   vault-event <event>        e.g. vault-event dhs26
set -eu

[ $# -eq 1 ] || { echo "usage: $0 <event>" >&2; exit 1; }
event="$1"

bao secrets enable -path="services-$event" -version=1 \
  -description="$event store for services" kv 2>/dev/null \
  && echo "mounted services-$event" || echo "services-$event already mounted"
bao secrets enable -path="mgmt-$event" -version=1 \
  -description="$event store for management" kv 2>/dev/null \
  && echo "mounted mgmt-$event" || echo "mgmt-$event already mounted"

# every event that has a mount, past and present (services-ldap is the
# directory secrets mount, never an event)
events=$(bao secrets list | awk '/^services-/ {print $1}' \
  | sed 's#^services-##; s#/$##' | grep -v '^ldap$' | sort)

svc_policy=$(mktemp); tech_policy=$(mktemp)
trap 'rm -f "$svc_policy" "$tech_policy"' EXIT

cat > "$svc_policy" <<EOF
# GENERATED by vault-event - do not edit; rerun for a new event.
# services team: the colo services store plus per-event stores
# (current event writable, past events readable).
path "services/*" { capabilities = ["create", "read", "update", "delete", "list"] }
EOF
cat > "$tech_policy" <<EOF
# GENERATED by vault-event - do not edit; rerun for a new event.
# tech: per-event management stores (current writable, past readable).
EOF

for e in $events; do
  if [ "$e" = "$event" ]; then
    svc_caps='["create", "read", "update", "delete", "list"]'
    mgmt_caps='["create", "read", "update", "delete", "list"]'
  else
    svc_caps='["read", "list"]'
    mgmt_caps='["read", "list"]'
  fi
  printf 'path "services-%s/*" { capabilities = %s }\n' "$e" "$svc_caps" >> "$svc_policy"
  printf 'path "mgmt-%s/*" { capabilities = %s }\n' "$e" "$svc_caps" >> "$svc_policy"
  printf 'path "mgmt-%s/*" { capabilities = %s }\n' "$e" "$mgmt_caps" >> "$tech_policy"
done

bao policy write services "$svc_policy" >/dev/null && echo "policy services regenerated"
bao policy write tech "$tech_policy" >/dev/null && echo "policy tech regenerated"
echo "event $event active; events known: $(echo $events | tr '\n' ' ')"
