#!/usr/bin/env python3
"""Determinism audit for the published ipplan.db (gen-3 pipeline).

Out of the hot path, on a daily timer: rebuild HEAD from source with
the vendored toolchain and compare against the artifact actually
being served from the publish dir. ANY difference beyond the
build_time stamp means tool drift or tampering - alarm loudly
(syslog err + failing unit) and leave the published artifact alone;
a human decides.

Lives in the repository (allevents/colo/svn-hooks/) next to the gate,
whose build/compile functions it reuses.

Usage: dh-ipplan-audit [<repo-path>]
"""

import importlib.machinery
import importlib.util
import os
import sqlite3
import subprocess
import sys
import syslog
import tempfile

PUBLISH = '/var/www/stuff'
DEFAULT_REPO = '/srv/svn/dh'


def load_gate():
    here = os.path.dirname(os.path.abspath(__file__))
    spec = importlib.util.spec_from_loader(
        'svn_pre_commit', importlib.machinery.SourceFileLoader(
            'svn_pre_commit', os.path.join(here, 'pre-commit')))
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def snapshot(db_path):
    """Every table's rows, minus the volatile build_time stamp."""
    conn = sqlite3.connect(db_path)
    tables = [r[0] for r in conn.execute(
        "SELECT name FROM sqlite_master WHERE type = 'table' "
        "AND name NOT LIKE 'sqlite_%'")]
    snap = {}
    for table in tables:
        rows = conn.execute('SELECT * FROM "%s"' % table).fetchall()
        if table == 'meta_data':
            rows = [r for r in rows if r[0] != 'build_time']
        snap[table] = sorted(map(repr, rows))
    conn.close()
    return snap


def main():
    repo = sys.argv[1] if len(sys.argv) > 1 else DEFAULT_REPO
    syslog.openlog('dh-ipplan-audit')
    published = os.path.join(PUBLISH, 'ipplan.db.xz')
    if not os.path.exists(published):
        print('nothing published yet, nothing to audit')
        return 0

    gate = load_gate()
    rev = subprocess.run(
        ['svnlook', 'youngest', repo], capture_output=True,
        text=True, check=True).stdout.strip()
    with tempfile.TemporaryDirectory() as tmp:
        rebuilt = os.path.join(tmp, 'rebuilt.db')
        inputs = gate.build_inputs(repo, '-r', rev)
        gate.compile_tree(inputs, rebuilt)
        conn = sqlite3.connect(rebuilt)
        conn.execute('UPDATE meta_data SET value = ? '
                     'WHERE name = "svn_revision"', (rev,))
        conn.commit()
        conn.close()

        served = os.path.join(tmp, 'served.db')
        with open(served, 'wb') as out:
            subprocess.run(['xz', '-dc', published], stdout=out,
                           check=True)

        ours, theirs = snapshot(rebuilt), snapshot(served)
    if ours == theirs:
        print('audit OK: published r%s matches a fresh rebuild' % rev)
        return 0

    diffs = []
    for table in sorted(set(ours) | set(theirs)):
        a, b = ours.get(table, []), theirs.get(table, [])
        if a != b:
            missing = [r for r in a if r not in b]
            extra = [r for r in b if r not in a]
            diffs.append('%s: %d rows only in rebuild, %d only in '
                         'published' % (table, len(missing), len(extra)))
    message = ('published ipplan.db.xz DIVERGES from a rebuild of '
               'r%s (tool drift or tampering): %s'
               % (rev, '; '.join(diffs)))
    syslog.syslog(syslog.LOG_ERR, message)
    print(message, file=sys.stderr)
    return 1


if __name__ == '__main__':
    sys.exit(main())
