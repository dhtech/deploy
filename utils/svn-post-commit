#!/usr/bin/env python3
"""svn post-commit dispatcher (gen-3 ipplan pipeline).

Rework of prod's five-jobs-in-bash+py2+ruby hook: one dispatcher with
failure-ISOLATED stages - a dead notifier never blocks a publish, and
every stage failure screams to syslog:

    trac     changeset sync (commits appear in Trac instantly)
    notify   syslog always; webhook notifiers join as a puppet-
             configured slot later
    publish  change detection (only when build inputs changed) ->
             pick up the pre-commit's STASHED build by input hash;
             on a mismatch (racing commit) rebuild with the same
             tool -> stamp svn_revision -> xz -> ATOMIC rename-swap
             into the publish dir: ipplan.db.xz + .sha256 + REVISION,
             dated ipplan-r<rev>.db.xz builds kept for rollback and
             diffing (pruned to KEEP)
    postpub  empty slot for downstream regeneration (prod: dhmap)

Invariant: the pre-commit gate compiled this same input with the same
tool - a publish-stage build failure here implies ENVIRONMENTAL
breakage, not bad input, and it alarms loudly.

Lives in the repository (allevents/colo/svn-hooks/) next to the
pre-commit gate, whose build/hash/compile functions it reuses.

Usage: svn-post-commit <repo-path> <revision>
"""

import hashlib
import importlib.machinery
import importlib.util
import os
import shutil
import sqlite3
import subprocess
import sys
import syslog

PUBLISH = '/var/www/stuff'
KEEP = 10
TRAC_ENV = '/srv/trac/dh'
TRAC_REPO = 'dh'


def load_gate():
    here = os.path.dirname(os.path.abspath(__file__))
    spec = importlib.util.spec_from_loader(
        'svn_pre_commit', importlib.machinery.SourceFileLoader(
            'svn_pre_commit', os.path.join(here, 'pre-commit')))
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def stage(name, failures, func, *args):
    """Run one stage; a failure is logged loudly and never blocks the
    stages after it."""
    try:
        func(*args)
    except (Exception, SystemExit) as error:
        failures.append(name)
        syslog.syslog(syslog.LOG_ERR,
                      'stage %s FAILED: %s' % (name, error))


def trac_sync(repo, rev):
    if not os.path.isdir(TRAC_ENV):
        return
    subprocess.run(
        ['trac-admin', TRAC_ENV, 'changeset', 'added', TRAC_REPO,
         str(rev)],
        capture_output=True, text=True, check=True, timeout=60)


def notify(gate, repo, rev):
    author = gate.svnlook('author', repo, '-r', rev).strip()
    log = gate.svnlook('log', repo, '-r', rev).strip().split('\n')[0]
    syslog.syslog(syslog.LOG_NOTICE,
                  'committed r%s by %s: %s' % (rev, author, log))
    # webhook notifiers (irc/discord/matrix) plug in here when a
    # puppet parameter configures them


def report_diff(gate, rev, work):
    """What this revision changed vs the published db, on stderr:
    svn shows post-commit stderr to the committer, so the change
    report lands in their commit output (gen-2 diff parity). Never
    blocks the publish - report failures only syslog."""
    current = os.path.join(PUBLISH, 'ipplan.db.xz')
    if not os.path.exists(current):
        return
    try:
        tool = gate.load_ipplan2db()
        old_db = work + '.prev'
        with open(old_db, 'wb') as out:
            subprocess.run(['xz', '-dc', current], stdout=out, check=True)
        prev = sqlite3.connect(old_db)
        before = tool.db_state(prev.cursor())
        prev.close()
        os.unlink(old_db)
        new = sqlite3.connect(work)
        lines = tool.format_diff(before, tool.db_state(new.cursor()))
        new.close()
        if lines:
            print('ipplan r%s changes:' % rev, file=sys.stderr)
            for line in lines:
                print(line, file=sys.stderr)
            syslog.syslog('r%s publish: %s' % (
                rev, '; '.join(entry for entry in lines
                               if not entry.startswith(' '))))
            # durable copy next to the dated builds (svn clients only
            # see post-commit stderr when the hook fails)
            tmp = os.path.join(PUBLISH, '.new-ipplan-r%s.diff' % rev)
            with open(tmp, 'w') as f:
                f.write('\n'.join(lines) + '\n')
            os.replace(tmp, os.path.join(
                PUBLISH, 'ipplan-r%s.diff' % rev))
    except Exception as error:
        syslog.syslog(syslog.LOG_WARNING,
                      'r%s: diff report failed: %s' % (rev, error))


def publish(gate, repo, rev):
    changed = gate.svnlook('changed', repo, '-r', rev)
    relevant = [parts[1] for parts in
                (line.split(None, 1) for line in changed.splitlines())
                if len(parts) == 2]
    if not any(p == 'currentevent' or p in gate.MANIFEST_PARTS
               or (p.endswith('/ipplan') and 'svn-hooks' not in p)
               for p in relevant):
        return

    inputs = gate.build_inputs(repo, '-r', rev)
    key = gate.input_hash(inputs)
    os.makedirs(PUBLISH, exist_ok=True)
    work = os.path.join(PUBLISH, '.build-r%s.db' % rev)

    stashed = os.path.join(gate.STASH, key + '.db')
    if os.path.exists(stashed):
        shutil.copy(stashed, work)
    else:
        # racing commit changed the inputs between gate and here:
        # rebuild with the very same tool
        syslog.syslog(syslog.LOG_WARNING,
                      'r%s: no stashed build for %s, rebuilding' % (
                          rev, key[:12]))
        gate.compile_tree(inputs, work)

    conn = sqlite3.connect(work)
    conn.execute('UPDATE meta_data SET value = ? '
                 'WHERE name = "svn_revision"', (str(rev),))
    conn.commit()
    conn.close()

    report_diff(gate, rev, work)

    dated = 'ipplan-r%s.db.xz' % rev
    with open(work, 'rb') as raw, \
            open(os.path.join(PUBLISH, '.new-' + dated), 'wb') as out:
        subprocess.run(['xz', '-9', '-c'], stdin=raw, stdout=out,
                       check=True)
    os.unlink(work)
    os.replace(os.path.join(PUBLISH, '.new-' + dated),
               os.path.join(PUBLISH, dated))

    # the stable names swap only after the dated build is in place -
    # a failure anywhere leaves the previous artifact serving
    with open(os.path.join(PUBLISH, dated), 'rb') as f:
        digest = hashlib.sha256(f.read()).hexdigest()
    tmp = os.path.join(PUBLISH, '.new-ipplan.db.xz')
    shutil.copy(os.path.join(PUBLISH, dated), tmp)
    os.replace(tmp, os.path.join(PUBLISH, 'ipplan.db.xz'))
    for name, content in (('ipplan.db.xz.sha256',
                           '%s  ipplan.db.xz\n' % digest),
                          ('REVISION', '%s\n' % rev)):
        tmp = os.path.join(PUBLISH, '.new-' + name)
        with open(tmp, 'w') as f:
            f.write(content)
        os.replace(tmp, os.path.join(PUBLISH, name))

    diffs = [f for f in os.listdir(PUBLISH)
             if f.startswith('ipplan-r') and f.endswith('.diff')]
    for old in sorted(diffs,
                      key=lambda f: int(f[len('ipplan-r'):-len('.diff')])
                      )[:-KEEP]:
        os.unlink(os.path.join(PUBLISH, old))
    dated_builds = sorted(
        f for f in os.listdir(PUBLISH)
        if f.startswith('ipplan-r') and f.endswith('.db.xz'))
    for old in sorted(dated_builds,
                      key=lambda f: int(f[len('ipplan-r'):-len('.db.xz')])
                      )[:-KEEP]:
        os.unlink(os.path.join(PUBLISH, old))
    syslog.syslog(syslog.LOG_NOTICE, 'published r%s (%s)' % (rev, dated))


def post_publish(gate, repo, rev):
    """Downstream regeneration slot (prod: dhmap). Empty until needed."""


def main():
    repo, rev = sys.argv[1], sys.argv[2]
    syslog.openlog('dh-svn-post-commit')
    gate = load_gate()
    failures = []
    stage('trac', failures, trac_sync, repo, rev)
    stage('notify', failures, notify, gate, repo, rev)
    stage('publish', failures, publish, gate, repo, rev)
    stage('postpub', failures, post_publish, gate, repo, rev)
    return 1 if failures else 0


if __name__ == '__main__':
    sys.exit(main())
