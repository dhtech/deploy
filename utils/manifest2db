#!/usr/bin/env python3
"""Compile the manifest yaml into ipplan.db (gen-3 ipplan2sqlite).

Provision reads ONLY the database at runtime; the yaml is the
human-edited source (svn later) and this loader is the build step,
run by seed.sh today and the svn pipeline in production. It loads:

    service(name, description, dest_ports)  services and their ports
    flow(name)                              named cross-site flows
    package_spec(name, spec)                full package spec as json
    meta_data manifest_globals/_apps        json rows
    firewall_rule(from_host, from_ip,       PRECOMPUTED flow pairings -
                  to_host, port)            the ruleset is data: query
                                            it, diff it between builds

Usage: manifest2db <manifest.yaml> <ipplan.db>
"""

import json
import os
import sqlite3
import sys

import yaml

sys.path.insert(0, os.path.join(os.path.dirname(
    os.path.abspath(__file__)), '..', 'server'))
from libdhdeploy import flows      # noqa: E402
from libdhdeploy import metadata   # noqa: E402


def load(manifest_path, db_path):
    with open(manifest_path) as f:
        manifest = yaml.safe_load(f)

    conn = sqlite3.connect(db_path)
    c = conn.cursor()
    c.executescript('''
        CREATE TABLE IF NOT EXISTS service (
            name TEXT PRIMARY KEY, description TEXT, dest_ports TEXT);
        CREATE TABLE IF NOT EXISTS flow (name TEXT PRIMARY KEY);
        CREATE TABLE IF NOT EXISTS package_spec (
            name TEXT PRIMARY KEY, spec TEXT);
        CREATE TABLE IF NOT EXISTS firewall_rule (
            from_host TEXT, from_ip TEXT, to_host TEXT, port INTEGER);
        DELETE FROM service; DELETE FROM flow;
        DELETE FROM package_spec; DELETE FROM firewall_rule;
        DELETE FROM meta_data
            WHERE name IN ('manifest_globals', 'manifest_apps');
    ''')

    for name, spec in sorted((manifest.get('services') or {}).items()):
        spec = spec or {}
        c.execute('INSERT INTO service VALUES (?, ?, ?)',
                  (name, spec.get('description', name),
                   ','.join(spec.get('destport', []))))
    for name in manifest.get('flows') or []:
        c.execute('INSERT INTO flow VALUES (?)', (name,))
    for name, spec in sorted((manifest.get('packages') or {}).items()):
        c.execute('INSERT INTO package_spec VALUES (?, ?)',
                  (name, json.dumps(spec or {}, sort_keys=True)))
    for key in ('globals', 'apps'):
        if manifest.get(key) is not None:
            c.execute('INSERT INTO meta_data VALUES (?, ?)',
                      ('manifest_' + key, json.dumps(manifest[key])))
    conn.commit()

    # materialize the flow pairings: the same engine that used to run
    # at ENC time now runs once here
    metadata.DB_FILE = db_path
    rules = 0
    for host in sorted(metadata.all_hosts_pkgs()):
        fw = flows.firewall_params(host, manifest)
        for port, sources in sorted(fw.get('open_tcp_scoped', {}).items()):
            for ip in sources:
                c.execute('INSERT INTO firewall_rule VALUES (?, ?, ?, ?)',
                          (metadata.lookup_ip(ip) or '', ip, host, port))
                rules += 1
    conn.commit()
    conn.close()
    print('manifest compiled: %d services, %d flows, %d packages, '
          '%d firewall rules' % (
              len(manifest.get('services') or {}),
              len(manifest.get('flows') or []),
              len(manifest.get('packages') or {}), rules))


if __name__ == '__main__':
    if len(sys.argv) != 3:
        sys.exit('usage: manifest2db <manifest.yaml> <ipplan.db>')
    load(sys.argv[1], sys.argv[2])
